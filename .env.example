# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.5-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.5-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash-thinking-exp
# GEMINI_MODEL=gemini-2.5-flash

# ── Ingest bridge (Hermes → career-ops) ──────────────────────────────────────
# Bearer token required by the ingest endpoint (ingest-server.mjs / POST /ingest).
# Hermes sends it in the Authorization header. Use a long random value, e.g.:
#   openssl rand -hex 32
# The same value must be set on the Hermes side.
CAREEROPS_INGEST_TOKEN=your_long_random_token_here

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY: do NOT set this when running the container — claude -p uses
# the mounted ~/.claude subscription token, and an env key would override it.
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration
