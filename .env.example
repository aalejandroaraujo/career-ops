# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Provider Selection ────────────────────────────────────────────────────────
# Which AI CLI processes batch evaluations. "qwen" (default) or "claude".
# Also configurable in config/profile.yml under provider.name.
# The web UI and ingest API can override this per-request.
# CAREEROPS_PROVIDER=qwen

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.5-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.5-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash-thinking-exp
# GEMINI_MODEL=gemini-2.5-flash

# ── Ingest bridge (Hermes → career-ops) ──────────────────────────────────────
# Bearer token required by the ingest endpoint (ingest-server.mjs / POST /ingest).
# Hermes sends it in the Authorization header. Use a long random value, e.g.:
#   openssl rand -hex 32
# The same value must be set on the Hermes side.
CAREEROPS_INGEST_TOKEN=your_long_random_token_here

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY: do NOT set this when running the container — claude -p uses
# the mounted ~/.claude subscription token, and an env key would override it.

# Claude subscription token for the container's `claude -p` workers.
# Generate with `claude setup-token` (valid ~1 year; host or container, same
# Max account). Do NOT rely on `claude auth login` inside the container: its
# refresh token hard-expires every ~30 days. _EXPIRES is the issue date + 1 year;
# queue-health uses it to send Telegram warnings 14/7/3/1 days before expiry.
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN_EXPIRES=YYYY-MM-DD
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration

# Bearer for the MCP endpoint (career-ops-mcp on 127.0.0.1:8766).
# Hermes sends this as `Authorization: Bearer <value>`.
CAREEROPS_MCP_TOKEN=

# Shared password for the LAN web UI (career-ops-web on :8767).
# REQUIRED — the web server refuses to start without it. Minimum 8 characters.
#   CAREEROPS_WEB_PASSWORD=$(openssl rand -hex 12)
CAREEROPS_WEB_PASSWORD=

# Optional: web session lifetime in days (default 30).
# CAREEROPS_WEB_SESSION_DAYS=30

# ── Queue health alerts ──────────────────────────────────────────────────────
# The ingest server checks whether the evaluation queue can actually do work
# (container logged in? runner paused? jobs queued but never started?) and POSTs
# a JSON body here when that state CHANGES — once per transition, both
# directions, never on every tick.
#
# Point it at anything that accepts a JSON POST: a Hermes webhook that relays to
# Telegram, ntfy (https://ntfy.sh/your-topic), Gotify, a Slack incoming webhook.
# Payload: {source, ok, text, problems[], checked_at} — `text` is a ready-to-send
# plain-text summary. Unset = no push; the web dashboard banner still works.
# CAREEROPS_ALERT_WEBHOOK=

# Telegram, natively — no adapter needed. The Hermes gateway is a long-poller
# (it listens on no port), so there is nothing on this host to POST to; the Bot
# API takes the POST directly. Use the SAME bot token Hermes uses and alerts
# land in the SAME chat from the SAME bot: Telegram serialises getUpdates, never
# sendMessage, so this cannot disturb Hermes' polling.
# CAREEROPS_ALERT_TELEGRAM_TOKEN=
# CAREEROPS_ALERT_TELEGRAM_CHAT=

# How often to evaluate queue health for alerting (ms, default 120000).
# CAREEROPS_ALERT_INTERVAL_MS=120000

# A queued job with no state row is only flagged once it is this old (minutes,
# default 15) — below that it is probably just waiting its turn.
# CAREEROPS_QUEUE_STALE_MINUTES=15

# A worker stuck in `processing` this long is flagged (minutes, default 150).
# Generous on purpose: job 190 legitimately took 2h27m across a retry.
# CAREEROPS_WORKER_STUCK_MINUTES=150

# ── Dashboard: Today + scouted actions ───────────────────────────────────────
# Max evaluate/dismiss actions the dashboard accepts per minute (default 12).
# Each evaluation costs minutes of a credentialed worker, and a button is much
# easier to lean on than a curl.
# CAREEROPS_WEB_WRITE_LIMIT=12

# Score at or above which an undecided evaluation is a recommendation to apply,
# and therefore shows on the Today tab (default 4.0).
# CAREEROPS_APPLY_THRESHOLD=4.0

# Days an apply-worthy evaluation may sit undecided before Today flags it
# (default 7). A Swiss corporate req is shortlisting by week three.
# CAREEROPS_DECISION_STALE_DAYS=7

# Scouted inbox path. Overridable only so the write endpoints' allow-list can be
# tested against a throwaway file; leave unset in production.
# CAREEROPS_PIPELINE_FILE=
